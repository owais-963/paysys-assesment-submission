# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database connection (same database seeded in Objective 1) ---
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_CONNECT_TIMEOUT=5

# --- Optional: MiniPay API base URL ---
# Left commented out by default: --health then checks only the database.
# Uncomment and set a real URL (e.g. http://127.0.0.1:8000) to also have
# --health check the API's own /health endpoint.
# API_BASE_URL=<API_BASE_URL>
API_TIMEOUT=5

# Minutes a transaction can sit in PROCESSING before it's flagged as an
# anomaly / counted by --stuck-summary. Matches sql/03_processing_over_15_minutes.sql.
STUCK_PROCESSING_MINUTES=15

LOG_LEVEL=INFO
