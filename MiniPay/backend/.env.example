# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database connection (same database seeded in Objective 1) ---
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# Connection pool sizing
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# Shared secret required on every /api/* request via the X-API-Key header.
# /health is intentionally left unauthenticated. Generate a real value with,
# e.g., `openssl rand -hex 32` -- never reuse the example below.
API_KEY=<API_KEY>

# Comma-separated list of origins allowed to call this API from a browser
# (the static frontend is served separately, so CORS must be enabled).
# Use "*" only for local evaluation; restrict this in any real deployment.
CORS_ALLOW_ORIGINS=*

# Pagination guardrails for GET /api/customers/{id}/payments
PAYMENTS_PAGE_SIZE_DEFAULT=20
PAYMENTS_PAGE_SIZE_MAX=100
